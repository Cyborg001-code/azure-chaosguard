# ==============================================================================
# Azure ChaosGuard - Microsoft Azure Cloud Configuration
# ==============================================================================
# Fill in your Azure credentials below whenever you are ready to connect
# your real Azure cloud account. Until then, ChaosGuard will automatically
# operate in safe local simulation mode with realistic Azure metrics.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AZURE SUBSCRIPTION & AUTHENTICATION
# ------------------------------------------------------------------------------
# Find these in the Azure Portal under "Subscriptions" or by running: az account show
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id-here
AZURE_TENANT_ID=your-azure-tenant-id-here
AZURE_RESOURCE_GROUP=rg-chaosguard-prod
AZURE_LOCATION=eastus

# Service Principal Credentials (Recommended for automated CI/CD and production)
# Generated via: az ad sp create-for-rbac --name "sp-chaosguard" --role contributor
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret

# ------------------------------------------------------------------------------
# 2. AZURE TARGET SERVICES (TARGETS FOR RESILIENCE TESTING)
# ------------------------------------------------------------------------------
# Azure Cosmos DB (Primary transactional database)
# Found in: Azure Portal -> Cosmos DB Account -> Keys -> Primary Connection String
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-primary-cosmos-key-here
AZURE_COSMOS_DATABASE=ChaosGuardStore
AZURE_COSMOS_CONTAINER=Orders

# Azure Cache for Redis (Circuit Breaker secondary fallback cache)
# Found in: Azure Portal -> Azure Cache for Redis -> Access Keys -> Primary connection string
AZURE_REDIS_HOST=your-redis-name.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_KEY=your-redis-primary-access-key-here
AZURE_REDIS_SSL=true

# ------------------------------------------------------------------------------
# 3. TELEMETRY & OBSERVABILITY
# ------------------------------------------------------------------------------
# Azure Application Insights (Distributed tracing and metrics)
# Found in: Azure Portal -> Application Insights -> Overview -> Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-guid-here;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# Azure SignalR Service (Real-time sub-second WebSocket dashboard feed)
# Found in: Azure Portal -> SignalR Service -> Keys -> Connection String
AZURE_SIGNALR_CONNECTION_STRING=Endpoint=https://your-signalr.service.signalr.net;AccessKey=your-key;Version=1.0;

# ------------------------------------------------------------------------------
# 4. AZURE OPENAI (SELF-TUNING REMEDIATION & PULL REQUEST GENERATOR)
# ------------------------------------------------------------------------------
# Found in: Azure Portal -> Azure OpenAI Service -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-openai-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ------------------------------------------------------------------------------
# 5. AZURE CHAOS STUDIO & FINOPS SPEND CEILING
# ------------------------------------------------------------------------------
# Maximum dollar spend permitted before the FinOps guardrail aborts the experiment
CHAOS_BUDGET_CEILING_USD=2.00
AZURE_CHAOS_STUDIO_EXPERIMENT_NAME=exp-cosmos-429-storm
